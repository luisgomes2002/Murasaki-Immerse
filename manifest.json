{
  "manifest_version": 3,
  "name": "Murasaki Immerse",
  "version": "1.0.0",
  "description": "Track your language immersion time on YouTube automatically",
  "permissions": ["storage", "identity", "downloads"],
  "host_permissions": ["https://www.googleapis.com/*", "*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "oauth2": {
    "client_id": "892204155433-lqdrklira71edq53ujtc20j5hc5kkbb4.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/youtube.readonly"]
  }
}

:root { --bg: #09090b; --card: #18181b; --subtle: #1c1c1f; --text: #fff; --text-sec: #a1a1aa; --muted: #71717a; --border: #27272a; --violet: #7c3aed; --violet-hover: #8b5cf6; color: var(--text); background: var(--bg); font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; background: var(--bg); }
.container { width: min(920px, calc(100% - 40px)); margin: 0 auto; padding: 72px 0; animation: fade-in-up .45s ease both; }
.header { display: flex; align-items: start; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
h1 { margin: 0; font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -1px; background: linear-gradient(135deg, var(--violet), var(--violet-hover)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
h2 { margin: 0 0 16px; color: var(--text-sec); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }
p { margin: 7px 0 0; color: var(--text-sec); }
button { border: 0; border-radius: 10px; padding: 9px 14px; color: #fff; background: var(--violet); cursor: pointer; font: inherit; font-weight: 700; transition: transform .2s ease, background .2s ease; }
button:hover { background: var(--violet-hover); transform: translateY(-1px); }
.card { padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); transition: transform .2s ease, box-shadow .2s ease; }
.language-list { display: flex; flex-direction: column; gap: 12px; }
.language-row { display: grid; grid-template-columns: 120px 1fr 80px; align-items: center; gap: 12px; }
.language-name, .time { font-variant-numeric: tabular-nums; }
.time { color: var(--text-sec); text-align: right; }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
.summary-card { display: grid; min-height: 112px; place-items: center; padding: 18px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); text-align: center; }
.summary-card span { align-self: end; color: #c4b5fd; font-size: 11px; font-weight: 800; letter-spacing: .7px; text-transform: uppercase; }
.summary-card strong { align-self: start; color: var(--violet); font-size: 34px; font-variant-numeric: tabular-nums; line-height: 1; }
.activity-card { margin-bottom: 16px; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.section-heading h2 { margin-bottom: 0; }
.section-heading p { margin-top: 4px; font-size: 12px; }
select { padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; color: var(--text); background: var(--subtle); font: inherit; }
.filters { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
.activity-scroll { overflow-x: auto; padding-bottom: 4px; }
.activity-grid { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 13px); grid-template-columns: repeat(var(--activity-columns, 12), 13px); gap: 4px; width: max-content; min-width: 100%; }
.activity-day { border-radius: 3px; background: var(--subtle); }
.activity-day[data-level="1"] { background: rgba(124, 58, 237, .35); }
.activity-day[data-level="2"] { background: rgba(124, 58, 237, .55); }
.activity-day[data-level="3"] { background: rgba(124, 58, 237, .75); }
.activity-day[data-level="4"] { background: var(--violet); }
.activity-legend { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin-top: 12px; color: var(--muted); font-size: 11px; }
.activity-legend i { width: 13px; height: 13px; border-radius: 3px; background: var(--subtle); } .activity-legend i:nth-of-type(1) { background: rgba(124, 58, 237, .35); } .activity-legend i:nth-of-type(2) { background: rgba(124, 58, 237, .55); } .activity-legend i:nth-of-type(3) { background: rgba(124, 58, 237, .75); } .activity-legend i:nth-of-type(4) { background: var(--violet); }
@media (max-width: 560px) { .container { width: min(100% - 28px, 920px); padding: 32px 0; } .summary-grid { grid-template-columns: 1fr; } .section-heading { flex-direction: column; } .filters { justify-content: flex-start; } .activity-grid { gap: 3px; } .language-row { grid-template-columns: 84px 1fr 64px; gap: 8px; } }
.track { height: 9px; overflow: hidden; border-radius: 999px; background: var(--subtle); } .fill { height: 100%; border-radius: inherit; background: var(--violet); }
@keyframes fade-in-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
